VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI provider: openrouter or gemini
AI_PROVIDER=openrouter

# Optional. Set the model supported by the selected provider.
# OpenRouter examples: google/gemini-3.8-flash, anthropic/claude-sonnet-4
# Gemini example: gemini-3.8-flash
AI_MODEL=google/gemini-3.8-flash

# Server-side only. Never expose these in NEXT_PUBLIC_* or VITE_* variables.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
